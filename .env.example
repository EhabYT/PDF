# Copy to .env and replace the secret before production use.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8000
# false for plain-HTTP loopback/LAN only; true when served over HTTPS (recommended for remote access).
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=
DATA_DIR=./storage
SESSION_HOURS=12
SESSION_IDLE_MINUTES=60
# Upload limits. Defaults: 50 MB/image, 100 MB/PDF, 500 MB/request, 300 pages.
# Behind Cloudflare's free/pro plan, keep MAX_UPLOAD_MB and MAX_PDF_MB <= 90
# because Cloudflare caps request bodies at 100 MB on those plans.
MAX_FILE_MB=50
MAX_PDF_MB=100
MAX_UPLOAD_MB=500
MAX_PAGES=300
MAX_PIXELS=40000000
MAX_OUTPUT_PIXELS=24000000
PDF_DPI=200
WORKER_POLL_SECONDS=0.5
WORKER_MEMORY_MB=1200
PAGE_TIMEOUT_SECONDS=120
OCR_TIMEOUT_SECONDS=35
OCR_LANGUAGES=deu+eng+ara
TESSERACT_CMD=tesseract
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Docker Compose loopback binding by default. Change only for explicit LAN use.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Optional Cloudflare Tunnel (see docs/CLOUDFLARE_TUNNEL.md).
# Keep BIND_ADDRESS=127.0.0.1 and protect the tunnel hostname with Cloudflare Access.
TUNNEL_TOKEN=
# When using the tunnel, set these to your exact HTTPS hostname:
# COOKIE_SECURE=true
# TRUSTED_HOSTS=scanner.example.com,localhost,127.0.0.1
# ALLOWED_ORIGINS=https://scanner.example.com
